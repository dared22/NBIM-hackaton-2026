# Kopier til .env og fyll inn de nøklene du trenger. .env er i .gitignore og skal aldri committes.

# Jev (Typesafe). Bare nødvendig med --jev i demoen, og når jev_mvp.py kjøres mot nye forslag.
# https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# EDINET (Japan). Bare for å hente nye japanske årsrapporter: python -m nbim_vote.fetch_edinet
# Gratis: https://api.edinet-fsa.go.jp
EDINET_API_KEY=

# OpenDART (Sør-Korea). Bare for å hente nye koreanske rapporter: python -m nbim_vote.fetch_dart
# Gratis: https://opendart.fss.or.kr
OPENDART_API_KEY=
